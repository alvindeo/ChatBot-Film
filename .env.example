# API Keys untuk LLM Services
# Uncomment dan isi dengan API key Anda

# Google Gemini API Key
# Dapatkan di: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key
# Dapatkan di: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Free & Fast!)
# Dapatkan di: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# TMDb API Key (untuk dataset film lebih lengkap)
# Dapatkan di: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Default LLM Provider (pilih: gemini, openai, groq, atau none)
DEFAULT_LLM=none
